# ── Neon Postgres connection ───────────────────────────────────────────────────
# Get this from: Vercel Dashboard → Storage → your Neon database → .env.local tab
# Or from: Neon Console → your project → Connection Details → Connection string
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require
